# Docker ignore file for Snapcraft
# Reduces build context size and improves build performance

# Git
.git
.gitignore
.gitmodules

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
PYMANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.coverage
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Documentation
docs/_build/
.readthedocs.yml

# Cache directories
.cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Snapcraft specific
*.snap
snap/.snapcraft/
.snapcraft/
parts/
stage/
prime/

# System files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log

# Node modules (for prettier)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Spread testing
spread.yaml
.spread-reuse

# CI/CD
.github/
.travis.yml
.appveyor.yml

# Editor configs that shouldn't be in container
.editorconfig
.pre-commit-config.yaml

# Docker files themselves
Dockerfile*
docker-compose*.yml
*.dockerignore
docker-dev.sh

# Local development
.local/
.env.local
.env.development
.env.test
.env.production

# Backup files
*.bak
*.backup
*.orig

# OS generated files
Desktop.ini
ehthumbs.db
Thumbs.db
